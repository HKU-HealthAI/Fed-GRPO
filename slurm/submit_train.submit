#!/bin/bash

# Specify the resources required (adjust according to your cluster).
# Example: '--gres=gpu:8' for 8 GPUs on the default partition.
#SBATCH --nodes=1 --gres=gpu:8 --mail-type=ALL

# Time limit
#SBATCH -t 4-00:00:00

# Initialize conda
. $HOME/miniconda3/etc/profile.d/conda.sh
conda activate fed-grpo

# Memory optimization to reduce fragmentation
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Number of GPUs allocated by SLURM
NUM_GPUS=${SLURM_GPUS_ON_NODE:-$(echo ${CUDA_VISIBLE_DEVICES} | tr ',' '\n' | wc -l)}

# Fed-GRPO Training
PYTHONUNBUFFERED=1 accelerate launch \
    --main_process_port $((29500 + $RANDOM % 1000)) \
    --num_processes=$NUM_GPUS \
    src/train.py --config config/train.yaml --method fed_grpo
